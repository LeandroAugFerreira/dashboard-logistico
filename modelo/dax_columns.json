  {
    "TableName":"fViagens",
    "ColumnName":"Faixa Tempo",
    "Expression":"\nSWITCH(\n    TRUE(),\n    fViagens[tempo_execucao_horas] <= 20, \"0-20h\",\n    fViagens[tempo_execucao_horas] <= 40, \"20-40h\",\n    fViagens[tempo_execucao_horas] <= 60, \"40-60h\",\n    fViagens[tempo_execucao_horas] <= 100, \"60-100h\",\n    fViagens[tempo_execucao_horas] <= 200, \"100-200h\",\n    \"200h+\"\n)"
  },
  {
    "TableName":"fViagens",
    "ColumnName":"Status Prazo",
    "Expression":"\nIF(\n    'fViagens'[atraso_horas] > 0,\n    \"Atrasado\",\n    \"No Prazo\"\n)"
  }
